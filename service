    }

    /* Navigation Links */
    .nav-menu {
      display: flex;
      align-items: center;
      gap: 32px;
      list-style: none;
    }

    .nav-menu a {
      text-decoration: none;
      color: #b0b5b9;
      font-size: 15px;
      font-weight: 400;
      transition: color 0.3s ease;
    }

    .nav-menu a:hover {
      color: #ffffff;
    }

    /* Active Link Underline */
    .nav-menu a.active {
      color: #ffffff;
      font-weight: 600;
      position: relative;
      padding-bottom: 6px;
    }

    .nav-menu a.active::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 2px;
      background-color: #d1b078;
    }

    /* Right Action Elements (Search & Phone) */
    .nav-actions {
      display: flex;
      align-items: center;
