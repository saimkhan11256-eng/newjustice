    /* --- Help Banner (Fix for Overlap & Positioning) --- */

/* 1. New Unique Outer Wrapper to prevent bleed and ensure correct margin */
.help-banner-wrapper {
    width: 100%;
    margin: 60px 0 40px 0; /* Ensures full width and correct top/bottom spacing */
    padding: 0 100px; /* Side padding relative to page edges, same as Practice Areas */
    box-sizing: border-box;
    font-family: 'Arial', sans-serif;
    clear: both; /* Prevents text wrap from above */
    display: block;
}

/* 2. Absolute Positioning Container for the Box */
.help-banner-wrapper .help-banner-container {
    width: 105%;
    max-width: 1100px;
    background-color: #5c524c;
    border-radius: 12px;
    margin: 0 auto; /* Center the box within the full-width wrapper */
    display: flex;
    align-items: center;
    justify-content: flex-end; /* Text and button to the right */
    padding: 50px 60px; /* Padding for text/button, left padding adjusted */
    position: relative; /* CRITICAL for the image placement */
    min-height: 170px;
    box-sizing: border-box;
}

/* 3. Image Wrapper with Bottom Alignment */
.help-banner-wrapper .help-banner-image-wrapper {
    position: absolute; /* Place relative to .help-banner-container */
    bottom: 2%;


    left: 10px; /* Position from left */
    width: 320px; /* Adjusted width */
    height: auto;
    overflow: visible; /* Let image overlap top of box */
    line-height: 0;
}

.help-banner-wrapper .help-banner-image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    /* Translate the image down slightly to stand on bottom edge */
    transform: translateY(2px);
}

/* 4. Text Content Content to the right */
.help-banner-wrapper .help-banner-content {
    flex: 1; /* Take up remaining space */
    color: #ffffff;
    max-width: 500px; /* Don't get too wide */
    text-align: left;
    margin-right: 40px; /* Space before button */
}

.help-banner-wrapper .help-banner-title {
    font-family: 'Georgia', serif;
    font-size: 42px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 12px 0;
    line-height: 1.2;
}

.help-banner-wrapper .help-banner-subtitle {
    font-size: 16px;
    color: #d1cbc7;
    margin: 0;
    font-weight: 400;
}

/* 5. Button and its Wrapper */
.help-banner-wrapper .help-banner-button-wrapper {
    flex: 0 0 auto; /* Button doesn't grow */
}

.help-banner-wrapper .help-banner-btn {
    display: inline-block;
    background-color: #a48c77;
    color: #ffffff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 18px 36px;
    border-radius: 8px;
    text-transform: uppercase;
    transition: background-color 0.3s ease;
    border: none;
    cursor: pointer;
}

.help-banner-wrapper .help-banner-btn:hover {
    background-color: #8f7763;
}

/* Responsive view */
@media (max-width: 1024px) {
    .help-banner-wrapper {
        padding: 0 40px;
    }
    .help-banner-wrapper .help-banner-container {
        padding: 40px 30px;
    }
    .help-banner-wrapper .help-banner-image-wrapper {
        left: 20px;
        width: 250px;
    }
}

@media (max-width: 900px) {
    .help-banner-wrapper .help-banner-container {
        flex-direction: column;
